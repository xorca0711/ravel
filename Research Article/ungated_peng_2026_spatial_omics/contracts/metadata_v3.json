{
  "schema_version": 1,
  "analysis_id": "Pg1-P01.metadata_v3",
  "owner": "Pg1-P01",
  "status": "frozen",
  "analysis_type": "metadata",
  "question": "Can public author library aliases, patient metadata and existing C3 inventories support defensible sample joins and identify the exact pathology/ROI qualification gaps?",
  "decision": "Complete PLAN stages 0-2 within inspected sources; authorize no region reproduction or A12 estimation without their required labels, geometry, panels and separate contracts.",
  "strongest_rival": "False identity through collapsing suffixes or equating patient-level matches with lesion, block, serial-section or same-cell correspondence; restricted public listings mistaken for absent data.",
  "discriminator": "Parse verbatim GEO descriptions and title patient labels separately from alias-derived IDs; check unique GSM and alias cardinalities, demographics, prior C3 fields and independent raw extraction. This cannot verify genotype or exact tissue relationships.",
  "evidence_refs": [
    "Research Article/ungated_peng_2026_spatial_omics/PLAN.md",
    "Research Article/ungated_peng_2026_spatial_omics/SOURCE_RECOVERY.md",
    "Research Article/ungated_peng_2026_spatial_omics/RQ_CONNECTIONS.md",
    "Research Article/gate2_C3_yu_lee_choi_min_2026/trials/u5_spatial_context/REPORT.md",
    "docs/research_reviews/2026-11-08-peng-spatial-reading/README.md",
    "Research Article/ungated_peng_2026_spatial_omics/AMENDMENT_V2.md",
    "Research Article/ungated_peng_2026_spatial_omics/AMENDMENT_V3.md"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "Paper, methods, original plans, prior C3/A11/A12/A13 outcomes, GEO sample counts and metadata previews were inspected before this freeze. Known 56/75/54 records, 25/23/25 patient labels, explicit aliases including P7 LUAD labels, prior 23-patient demographic match and missing annotations were exposed. No confirmatory design. V1 partial metadata outputs and five specific filename discrepancies were inspected after failed execution; v2 is fully outcome-exposed. V2 partial outputs exposed all six discrepancies, including WES P6 histology-token disagreement, and confirmed prior comparisons. No unexposed inference.",
  "biological_unit": "Patients are intended biological units; deposited libraries/sections and metadata records are immediate audited units.",
  "unit_status": "unknown",
  "nesting_and_overlap": "Libraries and sections nest within author patient labels; discovery platforms share source patients. Lesion, block, exact section and same-cell joins remain unknown; no independent replication or TMA identity is inferred.",
  "population_and_selection": "Public GEO records GSE307534 Visium, GSE308103 snRNA-seq and GSE307529 WES from selected surgical discovery tissues, plus prior C3 metadata inventories and recorded public-source attempts. No Xenium records are fabricated.",
  "contrast": "Exact deposited author aliases and patient/demographic fields across platforms versus prior C3 inventories; source availability versus required annotation products and published WES denominator.",
  "endpoint": "Per-library records; exact-alias crosswalk including unmatched counterparts; patient membership and demographic consistency; disagreement rows; source hashes/access ledger; annotation availability and independent verification. Verbatim filename aliases and discrepancy flags; complete failed-v1 archive and preservation manifest. File-level histology identity hold and propagated join flags.",
  "methods": "Standard-library SOFT parser preserving repeated fields; refuse duplicate GSM/within-platform alias or conflicting title/alias patient/histology; outer joins on exact author aliases preserving suffixes; case-insensitive demographic checks; compare C3 fields by GSM. Independent verifier uses separate regex-block parsing and set arithmetic without importing parser. Parse public Figure 1/5 object references; inspect existing archive member inventory only; no expression, large-archive download or author code execution. Filename tokens are extracted separately and linked through their explicit GSM URL; every discrepancy is retained. No suffix normalization. Byte-copy the twelve failed v1 artifacts into failed_v1/ and independently verify archive hashes and execution_failed status. Classify the five observed punctuation differences without normalizing identifiers; retain and hold the sixth WES histology conflict and its affected crosswalks. Archive every v2 failed file recursively, preserving v1 copies too.",
  "missingness_and_exclusions": "Retain every deposited library. Unknown lesion/block/section/ROI/core/barcode/coordinate IDs and original/reviewed per-library histology remain blank with reasons. Current deposited histology kept separately. P7 case-level review cannot identify original category or revised alias. WES79 versus GEO54 is unresolved. Missing supplements and restricted exports hold only dependent stages. Filename/author alias discrepancies remain explicit and do not change exact-author-alias joins. WES GSM9226083 file-level histology interpretation and matching remain held pending author clarification; explicit author alias correspondence is reported with the hold.",
  "multiplicity": "Not applicable: metadata audit and counts, no hypothesis tests, effects or selection of favorable endpoints.",
  "precision_status": "not_applicable",
  "precision_basis": "Deterministic finite-record inventory; no sampling precision, power calculation, effect margin or cell-based population inference.",
  "validation_scope": "internal",
  "design_identifiability": "unsupported",
  "inference_scope": "descriptive",
  "interpretation_limit": "Metadata consistency and shared alias are not proof of lesion identity, identical cells, independent biological replication, pathway activation, secretion, clone or fate. KAC/RPII remain distinct. No claim promotion or scientific acceptance.",
  "stop_rule": "Fail on source/code hash mismatch, unexpected parsed identifiers, nonunique GSM/alias, conflicting explicit identifiers, new annotation candidates or independent verification mismatch. Preserve failure receipt and outputs; amendments require new version. No fallback to expression-derived pathology, imputed panel genes or guessed specimen joins. V2 additionally requires independent agreement on both filename and author strings, all six exposed discrepancies plus the P6 WES-specific file hold and its propagated join flags, and byte-identical failure archive. A filename difference is reported and prevents filename-only equivalence, not a failure of an explicit GSM-to-file link.",
