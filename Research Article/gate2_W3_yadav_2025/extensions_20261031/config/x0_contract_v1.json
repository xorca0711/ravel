  "analysis_type": "metadata",
  "question": "Which exact source cells, source units, metadata joins and external source dependencies qualify checkpoint A without new external expression extraction?",
  "decision": "Execute mapped X1/X2 descriptions; return X3-X5 exact feasibility and design holds for review.",
  "strongest_rival": "Treating slices, wells, cell barcodes, library suffixes or accession IDs as independent animals, preparations or donors would create pseudoreplication or false pairing.",
  "discriminator": "Join GEO, BioSample and sequencing accessions; inspect workbook labels and source panel legends; validate count-file structure without treating missing identifiers as evidence of independence.",
  "evidence_refs": [
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/README.md",
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/LITERATURE_CONTEXT.md",
    "Research Article/gate2_W3_yadav_2025/REVIEW_LOG.md"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "Original outcomes and extension sheet values/PDF panels already exposed during reading. Metadata schemas and source methods inspected before freeze. No new mixed-inclusive summary or X2 group effects calculated.",
  "biological_unit": "Animals for whole-lung panels; human donor pairs or patients for human assays; coculture preparation identity and pooling remain unknown for GSE242510.",
  "unit_status": "unknown",
  "nesting_and_overlap": "Slices and wells nest in source patients or donor combinations; cells nest in libraries. Numeric library suffixes do not prove preparation pairing. Source panels and deposited data are reused published evidence, not independent replication.",
  "population_and_selection": "All six selected source sheets; all inherited Yadav receipts; all X3 metadata barcodes and 12 reported samples; all nine X4 GEO sample records; bounded SCAHN code and source dependencies.",
  "contrast": "Metadata and source mapping only: new Fig4C-D/6C-F; all frozen RNA barcodes; external X3-X5 source availability.",
  "endpoint": "Input/receipt identity, rectangular workbook cell/blank map, metadata barcode/sample/time/feature joins and external source dependencies; no expression effects.",
  "methods": "Reuse immutable original receipt hashes; map frozen source inventory to prespecified panel rectangles; read small X3 barcode/feature/sample tables, GEO sample metadata and complete author code tree. No expression matrix read.",
  "missingness_and_exclusions": "Retain every selected-sheet blank and zero. Unknown animal/donor/preparation/cross-assay identities remain unknown. Exact X3 barcode mismatch or occupied numeric cell outside map stops run; missing external state/culture/donor inputs hold only dependent jobs.",
  "multiplicity": "Not applicable: no hypothesis tests or biological effect estimates in this metadata run.",
  "precision_status": "not_applicable",
  "precision_basis": "Metadata inventory has no population precision claim. Unknown or sparse biological units constrain future effect analyses.",
  "validation_scope": "none",
  "design_identifiability": "unknown",
  "inference_scope": "descriptive",
  "interpretation_limit": "Metadata equality cannot establish independent biological replication. Workbook 4C amplitudes visibly disagree with supplied PDF; mapped workbook values may be described but exact graph fidelity is unresolved. Source normalization and missing arms restrict interpretation.",
  "stop_rule": "Stop at source and unit qualification. X1/X2 require separate frozen contracts. X3-X5 expression extraction awaits exact design review.",
