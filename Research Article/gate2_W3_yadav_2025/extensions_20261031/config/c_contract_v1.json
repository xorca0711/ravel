{
  "schema_version": 1,
  "analysis_id": "Yd1-P01.extension_c_v1",
  "owner": "Yd1-P01",
  "status": "frozen",
  "analysis_type": "metadata",
  "question": "Do the Gupta2020 first source and Wigerblad2022 sole fallback provide exact source/sample/preparation, feature and retained-state/target-zero support for a bounded human-neutrophil description?",
  "decision": "Return one conditional Gupta source-grounded description with exact execution holds, and the sole fallback eligibility limits; do not extract expression or silently remove state requirements.",
  "strongest_rival": "Treating raw droplet barcodes, mixed preparation libraries or distinct accessions as retained neutrophils, independent donors or complete target-zero denominators.",
  "discriminator": "Verify actual GEO parent/subseries relations; join GEO samples to BioSample and SRA experiments/runs; inventory listed files; inspect only separate Gupta gene-feature exports and preserve unknown retained-state and participant joins.",
  "evidence_refs": [
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/README.md",
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/LITERATURE_CONTEXT.md",
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/REVIEW_B.md",
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/CHECKPOINT_B_RESULTS.md",
    "Research Article/gate2_W3_yadav_2025/extensions_20261031/EXTERNAL_FEASIBILITY.md"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "Published primary Results, reported cell-state labels, GEO series/sample attributes, preparation schemas, file sizes and representative BioSample/SRA fields were read before freeze. Existing SCAHN source rows and Yadav outcomes are exposed. New gene-feature files acquired but target matching not yet executed. No target-expression query, matrix, H5, raw reads or classifier accessed.",
  "biological_unit": "Published healthy volunteers; exact participant-to-GSM/cross-preparation/cross-study joins unresolved. Libraries and sequencing runs are nested observations, not independent donors.",
  "unit_status": "unknown",
  "nesting_and_overlap": "Gupta and Wigerblad already contribute to SCAHN. Distinct BioSample/SRA accessions do not establish participant independence. Wigerblad mixes whole-blood, granulocyte and purified-neutrophil preparations; title tokens are unverified donor clues.",
  "population_and_selection": "All seven GSE145230 and nineteen GSE188288 reported sample records, corresponding BioSample/SRA metadata, complete two-series file listings and seven small Gupta feature-only exports. Gupta selected first on source completeness; Wigerblad sole fallback, not chosen by target outcomes.",
  "contrast": "Metadata availability and source/unit joins only. A conditional raw-count/state description is specified for review but not executed.",
  "endpoint": "Exact source/sample/library/preparation maps, public attributes, file byte sizes, original-reference target feature membership, unknown author cell/state assignments, target-zero denominator and overlap holds.",
  "methods": "Parse GEO key/value metadata and BioSample XML, join SRA run-info by experiment/BioSample, inventory exact source file sizes, and match fixed ARG1/IL6R symbols in separate feature exports. Blank unavailable values remain unknown. No expression input is opened. Independent raw-source/feature/file-size reread precedes interpretation.",
  "missingness_and_exclusions": "All source samples and file listings retained. No author retention/state barcode export recovered; raw barcode files are not assumed cells. Wigerblad feature availability is unknown because only expression-bearing H5 is listed. No labels, donor links, fresh/frozen handling, time or capture coverage inferred from absence.",
  "multiplicity": "Not applicable: source metadata and availability only, no biological effect tests.",
  "precision_status": "not_applicable",
  "precision_basis": "No population effect estimated. Eligibility and metadata counts are not power calculations.",
  "validation_scope": "none",
  "design_identifiability": "unknown",
  "inference_scope": "descriptive",
  "interpretation_limit": "Feature membership proves an assay reference entry, not transcription, protein or functional competence. Missing annotations or unmeasured genes cannot be zero-filled. Raw cell-calling differences and preparation effects limit transport; no pooled study effect, population test, secretion, lineage or IPF repair claim.",
  "stop_rule": "Stop after this bounded two-lead metadata pass and reviewable conditional design/holds. No expression calculation, new classifier, additional atlas studies or silent reduction of the state question. Reopen with exact retained-cell/state/denominator and unit/preparation evidence plus numerical design/resource review.",
