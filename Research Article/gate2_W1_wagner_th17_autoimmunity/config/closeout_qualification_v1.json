  "analysis_type": "metadata",
  "question": "Which remaining historical Compass, ATAC and functional source stages are executable, and can every earlier failed-run byte and failure status be preserved before the pre-RQ checkpoint?",
  "decision": "Close source eligibility with explicit qualified/held dispositions; archive the three earlier failed executions using the existing Nb5 workflow without changing validators or claiming numerical completion.",
  "strongest_rival": "A convenient runtime, mismatched source or omitted failure may create false reproduction; shared sample labels may be mistaken for physical correspondence.",
  "discriminator": "Require Git-blob/SHA pin checks, model ZIP integrity, raw-SOFT versus R0 exact ATAC identity joins, recorded acquisition failures and original/archive byte equality.",
  "evidence_refs": [
    "Research Article/gate2_W1_wagner_th17_autoimmunity/REPRODUCTION_SCOPE.md",
    "Research Article/gate2_W1_wagner_th17_autoimmunity/EVIDENCE_MAP.md",
    "Research Article/gate2_W1_wagner_th17_autoimmunity/PRECEDENT_REVIEW.md",
    "Research Article/gate2_N4_nabhan_aging_atlas_2020/config/failed_run_preservation_v1.json"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "Published methods and conclusions, previous Wagner results, raw-source headers and acquisition/runtime failures are exposed. No new reaction, accessibility or functional contrast is calculated. RNA limma v1 completed independently under its own frozen contract.",
  "biological_unit": "Source-labelled animal/preparation for future inference; files and source identities for this qualification.",
  "unit_status": "unknown",
  "nesting_and_overlap": "Twelve ATAC libraries represent three source animal labels across two lineages and two treatment conditions. Cross-assay WT labels do not prove shared physical specimens. Failed files and source outputs are reused evidence, not replication.",
  "population_and_selection": "All twelve deposited ATAC sample metadata records; nine pinned historical Compass code/model files; every file in three known failed Wagner run directories; all local new acquisition records.",
  "contrast": "Raw SOFT identities versus prior R0; historical/example reaction-ID sets; source byte streams versus preservation copies. No biological treatment contrast.",
  "endpoint": "Eligibility and source-fidelity dispositions, exact identity matches, model/file integrity, complete failure provenance.",
  "methods": "Verify all nine source files against saved SHA256 and Git blob hashes at d70793595ab6a3c897a07f3bd638b65c461ee47d, test model ZIP CRC, inventory expression dimensions and reaction-ID sets without score calculation. Recover ATAC sample labels directly from raw SOFT, assert 12 unique animal-lineage-treatment records and exact R0 identities; record mm10 and explicit missing peak/source inputs. Inventory functional panels from reviewed paper/catalogue without inventing raw values or digitizing. Copy every earlier failed-run file byte-for-byte to prefixed archived filenames and compare source hashes again. Keep original failure statuses and missing never-produced outputs. Preserve original local files and earlier commit history; use successful archive receipt instead of unsuccessful registry entries as in existing Nb5.",
  "missingness_and_exclusions": "No failed file or ATAC source sample excluded. Missing peak matrices, supplement workbooks, functional values and licensed historical solver remain explicit holds. No modern algorithm or synthetic measurements substitute.",
  "multiplicity": "No biological hypothesis tests; exact metadata and file checks only.",
  "precision_status": "not_applicable",
  "precision_basis": "Byte and identifier equality, not biological sample-size adequacy.",
  "validation_scope": "none",
  "design_identifiability": "unknown",
  "inference_scope": "descriptive",
  "interpretation_limit": "Eligibility completion is not execution of held stages. Reaction ID overlap cannot resolve exact stoichiometry, bounds or the 1912-versus-1911 grouping difference. Archived failed receipts remain failed; no scientific acceptance or new RQ is recorded.",
  "stop_rule": "Stop on original status mismatch, missing selected files, hash/CRC failure, source-label mismatch or duplicate/unexpected ATAC design. Holds remain holds; do not relax source requirements.",
