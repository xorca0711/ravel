  "analysis_id": "A32.resolution_context_v1",
  "owner": "A32",
  "status": "frozen",
  "analysis_type": "exploratory",
  "question": "Which source-state myeloid RNA injury contrasts and young-D14 fibroblast matrix-RNA changes are estimable in GSE234197, given insufficient epithelial support for joint resolution inference?",
  "decision": "Nominate bounded RNA context where supported; retain the inability to decide three-compartment resolution coupling or the canonical source-ARG1 functional comparison.",
  "strongest_rival": "Injury severity, recovered population composition, depth/dissociation selection and capture-by-condition effects can create apparent coordination without ARG1 mediation.",
  "discriminator": "Keep source-state RNA and relative recovery separate; compare three BLM versus three PBS mice within each age/day capture. Broad AM_all is explicitly composition-sensitive secondary context.",
  "evidence_refs": [
    "RQ_Specified/A32_myeloid_arg1_matrix_epithelial_recovery/reports/RESOLUTION_SCREEN_SPEC_V1.md",
    "RQ_Specified/A32_myeloid_arg1_matrix_epithelial_recovery/LITERATURE_CONTEXT.md",
    "analysis/research/runs/A32_resolution_metadata_v1_20261103/receipt.json"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "Published Truchi, Speth, Yadav, Choi, Strunz and Tsukui results and repository history exposed. Exact 14 genes fixed before new expression; source metadata and barcode/HTO support then determined the >=10-cell rule and held epithelial contrasts. No newly aggregated gene outcomes viewed before freeze.",
  "biological_unit": "Original male mouse, uniquely identified by age/day capture plus HTO tag; cells nested within source-labelled state.",
  "unit_status": "verified",
  "nesting_and_overlap": "Thirty-six distinct capture+HTO mice, three PBS and three BLM in each of six age/day captures. Unpaired treatment arms; cross-sectional days. Genes, states, AM_all and contrasts reuse mice/data and are not independent replication.",
  "population_and_selection": "Deposited retained whole-lung cells, source celltype labels, young/old D14/D28/D60. Ten myeloid states plus fibroblasts and AT1/AT2. Mouse/state needs >=10 cells; every zero/low-support row retained. Full 3-versus-3 required for contrasts. All epithelial effects held; fibroblast complete support only YoungD14.",
  "contrast": "Unpaired equal-mouse BLM-minus-PBS mean log2(CPM+1), separately within age/day capture, for each fixed state/gene. No pooled times, direct age effect or cross-compartment regression.",
  "endpoint": "Fourteen individual RNA features: Arg1/Spp1/Trem2 in myeloid; Col1a1/Col3a1/Fn1/Cthrc1 in fibroblasts; Krt8/Cldn4/Sftpc/Abca3/Ager/Hopx/Aqp5 in AT1/AT2. Raw UMI pseudobulk CPM denominator is all RNA UMI in mouse/state. Relative recovered-cell proportions separate.",
  "methods": "Stream original GEO coordinate matrices; exact barcode join plus every retained-cell RNA UMI/detected-feature parity. Mouse pseudobulk log2(CPM+1); 95% pointwise Welch-t descriptive intervals. Zero observed variance retains point difference but NA interval. Independent native-R original YoungD14 matrix arithmetic plus all-contrast R interval/eligibility verification. Fixed complete heatmap, support and focal individual-mouse plots.",
  "missingness_and_exclusions": "No cell filtering beyond source retention; no gene substitutions or imputation. Missing/ambiguous gene or raw/source mismatch stops. Below ten cells RNA estimates are NA; any missing arm mouse holds the contrast. Source-state zero cells remain zero support, never zero inferred expression.",
  "multiplicity": "All 51 state/gene combinations across six captures are reported, including held rows. No p-values, significance-based selection or simultaneous intervals.",
  "precision_status": "unknown",
  "precision_basis": "Three mice per arm; observed between-mouse variance only, normality untestable and intervals fragile. Ten cells is a pragmatic measurement-support floor, not power. No meaningful-effect or equivalence margin.",
  "validation_scope": "internal",
  "design_identifiability": "unknown",
  "inference_scope": "descriptive",
  "interpretation_limit": "RNA is not ARG1 catalysis, protein activity, deposited collagen, lineage or mature epithelial function. Age/day confounded with run; condition subtraction cannot exclude run-by-condition effects. This source cannot answer joint three-compartment resolution or fibroblast resolution trajectories.",
  "stop_rule": "Stop for invalid hashes, IDs, counts, dimension/UMI/feature parity, missing panel genes or verification failure. Retain all held states and unfavorable results. No outcome-driven floors, panels or cohort expansion.",
