{
  "schema_version": 1,
  "analysis_id": "Nk17-P01.s5m_molecular_integration_v2",
  "owner": "Nk17-P01",
  "status": "frozen",
  "analysis_type": "descriptive",
  "question": "Can S5M count-zero warnings be corrected to their intended raw-count meaning while retaining every frozen feature, source value, qualification, coefficient and covariance result?",
  "decision": "Use v2 flags only after raw-count semantic verification and exact v1 preservation checks; return actual corrected S5M for coordinator review before S5F. This correction supplies no new biological result or acceptance.",
  "strongest_rival": "A repeated column-name heuristic can pass numerical verification while conflating distinct biological measurement meanings; an overly broad correction could silently alter eligibility or coefficients.",
  "discriminator": "Explicit 23-field count-zero allowlist versus a separate two-field adjustment-range flag. A separate verifier reconstructs all count-zero flags directly from 16 original raw-count files, checks every unchanged joined source field and preserves five result/figure files byte-for-byte.",
  "evidence_refs": [
    "Research Article/ungated_naik_2017_inflammatory_memory/S5M_AMENDMENT_V2.md",
    "Research Article/ungated_naik_2017_inflammatory_memory/S5M_RESULTS_V1.md",
    "Research Article/ungated_naik_2017_inflammatory_memory/S5M_METHOD_V1.md",
    "Research Article/ungated_naik_2017_inflammatory_memory/LITERATURE_CONTEXT.md"
  ],
  "prior_outcome_exposure": "exposed",
  "exposure_record": "All S5M v1 outputs and prior stages were exposed before this correction. Coordinator identified the semantic defect before S5M acceptance and authorized bounded v2. Four artificial semantic/tamper tests passed with 247 independent checks; these tests read no real biological inputs. The correction does not erase prior exposure.",
  "biological_unit": "Separate deposited RNA and ATAC libraries with source-reported biological replication/pooling; exact animal membership, overlap and cross-assay matching unknown. Gene features and TSS proxies are the descriptive association units, not biological replicates.",
  "unit_status": "unknown",
  "nesting_and_overlap": "Original GSE92967 source reused across stages. S2 D30 and S4 B0 reuse GSM2440989-992 with different frozen normalization contexts. W6/W12 adjusted effects share subtraction of L0. Multiple genes may share a proxy, nearby windows overlap, and all widths/references reuse source libraries.",
  "population_and_selection": "Exactly the v1 47,729 gene records and fixed primary/all-mapped universes; preserve eligibility, source/annotation status and all original source fields. No new selection or threshold.",
  "contrast": "No new biological contrast. Distinguish any original RNA count zero across 16 deposited libraries from an S4 W6/W12 adjusted-contrast range including zero. Retain the 312/96 v1 association/covariance rows unchanged.",
  "endpoint": "Two separately named warning aggregates, per-universe counts and corrected fixed-anchor display. Byte-identical v1 coefficients, covariance components, ATAC values and association figure; no new association fitting.",
  "methods": "S5M_AMENDMENT_V2 defines explicit count and range allowlists, strict parsing, streaming exact source-field preservation, summary/manifest updates and corrected Figure 2. Copy associations, covariances, gene ATAC table and Figure 1 PNG/PDF byte-for-byte. Independent stdlib verifier uses original 16 raw-count files without importing the correction allowlist/helpers, checks all 23 source zero flags and all copied fields, summaries and anchor records, with exact equality. No source analysis or coefficients are recomputed.",
  "missingness_and_exclusions": "No new exclusions. Every declared raw-count input must have matching gene IDs and nonnegative integer counts; all explicitly required source flag fields must be present and valid. Missing/invalid fields fail rather than becoming false or zero. All prior unassayed/missing/eligibility flags are preserved.",
  "multiplicity": "No new tests or selections. Retain all 312 coefficients, 96 covariance identities and five paper-selected exposed anchors without selecting outcomes.",
  "precision_status": "not_applicable",
  "precision_basis": "Exact byte/string/boolean/count equality for this bounded correction. Reuse the v1 arithmetic verification with its documented semantic limitation; neither supplies independent biological replication or population uncertainty.",
  "validation_scope": "none",
  "design_identifiability": "unknown",
  "inference_scope": "descriptive",
  "interpretation_limit": "Association cannot identify same-cell regulation, causal chromatin persistence, molecular mediation or repair. Width/reference/normalization agreement is not independent replication. Rank shifts depend on the universe and zero-tie mass, even with unchanged local zero means. S3 omits noncoding/distal regions and original domains. Naik Fig5c reported IL1beta protein increase without Il1b transcript increase, so weak RNA alignment alone does not refute its protein/functional premise. Source N/endpoint issues in later S5F remain separate.",
  "stop_rule": "Require committed frozen amendment/code/contract and matching v1/raw-count hashes. Fail on any unexpected source flag, raw-count discrepancy, copied field or coefficient change, incomplete ID join, or independent-verification error. Preserve v1 and failed real runs. No source biological rerun, new analysis selection or S5F execution before corrected S5M review.",
  "runtime": "python",
  "entrypoint": "Research Article/ungated_naik_2017_inflammatory_memory/scripts/s5m_correct_flags_v2.py",
